# Postgres (matches docker-compose.yml)
POSTGRES_USER=stockwatch
POSTGRES_PASSWORD=stockwatch
POSTGRES_DB=stockwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redpanda (Kafka-API compatible broker, matches docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Polling intervals: X = live price granularity, Y = metadata granularity
PRICE_POLL_INTERVAL_SECONDS=600
SLOW_DIM_POLL_INTERVAL_SECONDS=86400

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# NewsAPI.org (free "Developer" tier) - https://newsapi.org/register
# Free tier: 100 requests/day, articles delayed ~24h, ~1 month lookback, non-commercial use only.
# Used for sector/industry news (yfinance has no such endpoint); company news stays on yfinance.
NEWSAPI_API_KEY=
